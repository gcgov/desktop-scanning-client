<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScanBridge</RootNamespace>
    <AssemblyName>ScanBridge</AssemblyName>
    <ApplicationIcon>Resources\scanbridge.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel + minimal APIs hosted inside the WinForms process -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- NAPS2.Sdk and companions are LGPL-2.1 (see THIRD-PARTY-NOTICES.md); consumed
         as unmodified assemblies, folder-published so they stay user-replaceable. -->
    <PackageReference Include="NAPS2.Sdk" Version="1.3.0" />
    <PackageReference Include="NAPS2.Images.Gdi" Version="1.3.0" />
    <!-- 32-bit worker process so 32-bit TWAIN drivers work from this 64-bit app -->
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="1.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\scanbridge.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
