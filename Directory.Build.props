<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Overridden by CI at release time: dotnet publish -p:Version=x.y.z -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Company>ScanBridge contributors</Company>
    <Product>ScanBridge</Product>
    <!-- LGPL note: NAPS2.Sdk and companions are LGPL-2.1. Keep them as unmodified,
         separately-replaceable assemblies: never enable trimming, single-file with
         compression, or IL merging for release builds. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
